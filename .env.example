# Optional local configuration. Copy to .env; never commit live credentials.
# Relative SQLite paths resolve from the directory where you launch the app.
DATABASE_URL=sqlite:///./rag_kb.db

# Local synthetic data by default; false enables live ConnectWise on request.
DEMO_MODE=true
MANAGEMENT_TOKEN=
WEBHOOK_SECRET=
CONNECTWISE_TIMEOUT_SECONDS=15

# Live ConnectWise Manage credentials and full HTTPS API root ending /apis/3.0.
CONNECTWISE_URL=
CONNECTWISE_COMPANY_ID=
CONNECTWISE_PUBLIC_KEY=
CONNECTWISE_PRIVATE_KEY=
CONNECTWISE_CLIENT_ID=

# Embedded Qdrant needs no server/key. Use one process for the same local path.
QDRANT_MODE=embedded
QDRANT_PATH=.qdrant
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=knowledge_base
QDRANT_API_KEY=
QDRANT_TIMEOUT_SECONDS=15
# Hash is lexical, deterministic and requires no model/download.
EMBEDDING_PROVIDER=hash
# Only FastEmbed uses this model name; install the optional extra first.
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIMENSION=384
EMBEDDING_CACHE_DIR=.fastembed_cache
CHUNK_SIZE=1000
CHUNK_OVERLAP=150

# Drafting: local is deterministic extraction, not an LLM; needs no key/download.
DRAFT_PROVIDER=local
DRAFT_TIMEOUT_SECONDS=30
# Optional Ollama: start your own server and preinstall your chosen model.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_DRAFT_MODEL=llama3.2
# Optional OpenAI structured drafting; only used with DRAFT_PROVIDER=openai.
OPENAI_DRAFT_MODEL=gpt-4o-mini
OPENAI_API_KEY=
